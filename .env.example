# Copy to .env and fill in. Never commit the real .env.
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instance/finance_hub.db
# Set to DEBUG only when actively troubleshooting; balances are logged at DEBUG.
LOG_LEVEL=INFO
# Allow self-registration (set to "false" once your users exist).
ALLOW_REGISTRATION=true
